local btnTeleport = Instance.new("TextButton")
btnTeleport.Size = UDim2.new(1, -10, 0, 35)
btnTeleport.Text = "TELEPORT: OFF"
btnTeleport.Font = Enum.Font.GothamBlack
btnTeleport.TextColor3 = Color3.fromRGB(255, 255, 255)
btnTeleport.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
btnTeleport.LayoutOrder = 2
local corner2 = Instance.new("UICorner") corner2.CornerRadius = UDim.new(0, 6) corner2.Parent = btnTeleport
btnTeleport.Parent = Frame

btnTeleport.MouseButton1Click:Connect(function()
    TeleportEnabled = not TeleportEnabled
    btnTeleport.Text = TeleportEnabled and "TELEPORT: ON" or "TELEPORT: OFF"
