local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Camera = workspace.CurrentCamera

local Selected = {}

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PlayerSelectorGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Frame = Instance.new("ScrollingFrame")
Frame.Size = UDim2.new(0, 200, 0, 300)
Frame.Position = UDim2.new(0, 50, 0, 100)
Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Frame.BorderSizePixel = 0
Frame.ScrollBarImageColor3 = Color3.fromRGB(200, 200, 200)
Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y 
Frame.CanvasSize = UDim2.new(0, 0, 0, 0)
Frame.Parent = ScreenGui

local UICornerFrame = Instance.new("UICorner")
UICornerFrame.CornerRadius = UDim.new(0, 8)
UICornerFrame.Parent = Frame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Padding = UDim.new(0, 5)
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIListLayout.SortOrder = Enum.SortOrder.Name
UIListLayout.Parent = Frame

local UIPadding = Instance.new("UIPadding")
UIPadding.PaddingTop = UDim.new(0, 5)
UIPadding.PaddingBottom = UDim.new(0, 5)
UIPadding.Parent = Frame

local function createPlayerButton(player)
    if Frame:FindFirstChild(player.Name) then return end 

    local btn = Instance.new("TextButton")
    btn.Name = player.Name
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Text = player.Name
    btn.Font = Enum.Font.GothamSemibold
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.AutoButtonColor = true
    
    local UICornerBtn = Instance.new("UICorner")
    UICornerBtn.CornerRadius = UDim.new(0, 6)
    UICornerBtn.Parent = btn
    
    btn.Parent = Frame

    btn.MouseButton1Click:Connect(function()
        if Selected[player.Name] then
            Selected[player.Name] = nil
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        else
            Selected[player.Name] = player
            btn.BackgroundColor3 = Color3.fromRGB(40, 200, 70) 
        end
    end)
end

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        createPlayerButton(plr)
    end
end

Players.PlayerAdded:Connect(function(plr)
    createPlayerButton(plr)
end)

Players.PlayerRemoving:Connect(function(plr)
    Selected[plr.Name] = nil 
    local button = Frame:FindFirstChild(plr.Name)
    if button then
        button:Destroy()
    end
end)

RunService:BindToRenderStep("CameraLockToHead", Enum.RenderPriority.Camera.Value + 1, function()
    local targetHead = nil
    for _, targetPlayer in pairs(Selected) do
        local targetCharacter = targetPlayer.Character
        if targetCharacter then
            targetHead = targetCharacter:FindFirstChild("Head")
            if targetHead then break end
        end
    end

    if targetHead then
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
    end
end)

RunService.Heartbeat:Connect(function()
    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    
    if localRoot then
        for name, targetPlayer in pairs(Selected) do
            local targetCharacter = targetPlayer.Character
            local targetTorso = targetCharacter and (targetCharacter:FindFirstChild("Torso") or targetCharacter:FindFirstChild("UpperTorso"))
            
            if targetTorso then
                for _, part in ipairs(localCharacter:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("Decal") then
                        part.Transparency = 1
                    end
                end
                
                -- Te coloca justo detrás del jugador, en lugar de flotando arriba
                localRoot.CFrame = targetTorso.CFrame * CFrame.new(0, 0, 3)
                break
            end
        end
    end
end)
