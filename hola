local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Camera = workspace.CurrentCamera

-- Variables de Estado
local TargetPlayer = nil
local AimbotEnabled = false
local TeleportEnabled = false
local HitboxEnabled = false
local WasHovering = false

-- ==========================================
-- 1. CREACIÓN DEL MENÚ (UI)
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PlayerSelectorGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Frame = Instance.new("ScrollingFrame")
Frame.Size = UDim2.new(0, 200, 0, 400) -- Hice el menú un poco más largo
Frame.Position = UDim2.new(0, 50, 0, 100)
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Frame.BorderSizePixel = 0
Frame.ScrollBarImageColor3 = Color3.fromRGB(150, 150, 150)
Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y 
Frame.CanvasSize = UDim2.new(0, 0, 0, 0)
Frame.Parent = ScreenGui
Frame.Active = true
Frame.Draggable = true 

local UICornerFrame = Instance.new("UICorner")
UICornerFrame.CornerRadius = UDim.new(0, 8)
UICornerFrame.Parent = Frame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Padding = UDim.new(0, 5)
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Parent = Frame

local UIPadding = Instance.new("UIPadding")
UIPadding.PaddingTop = UDim.new(0, 5)
UIPadding.PaddingBottom = UDim.new(0, 5)
UIPadding.Parent = Frame

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightControl then
        Frame.Visible = not Frame.Visible
    end
end)

-- ==========================================
-- 2. BOTONES MAESTROS (TOGGLES)
-- ==========================================
local function createToggle(name, color, order, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Text = name .. ": OFF"
    btn.Font = Enum.Font.GothamBlack
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.LayoutOrder = order
    local corner = Instance.new("UICorner") corner.CornerRadius = UDim.new(0, 6) corner.Parent = btn
    btn.Parent = Frame

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and name .. ": ON" or name .. ": OFF"
        btn.BackgroundColor3 = state and color or Color3.fromRGB(45, 45, 45)
        callback(state)
    end)
end

-- Botón 1: Aimbot (Rojo)
createToggle("AIMBOT", Color3.fromRGB(180, 20, 20), 1, function(state) AimbotEnabled = state end)

-- Botón 2: Teleport/Ghost (Azul)
createToggle("TELEPORT", Color3.fromRGB(40, 150, 200), 2, function(state) TeleportEnabled = state end)

-- Botón 3: Hitbox Expander (Púrpura)
createToggle("HITBOX", Color3.fromRGB(150, 40, 200), 3, function(state) HitboxEnabled = state end)

-- Separador
local Separator = Instance.new("Frame")
Separator.Size = UDim2.new(1, -20, 0, 2)
Separator.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
Separator.LayoutOrder = 4
Separator.Parent = Frame

-- ==========================================
-- 3. LISTA DE JUGADORES
-- ==========================================
local function createPlayerButton(player)
    if Frame:FindFirstChild(player.Name) then return end 

    local btn = Instance.new("TextButton")
    btn.Name = player.Name
    btn.Size = UDim2.new(1, -10, 0, 30)
    btn.Text = player.Name
    btn.Font = Enum.Font.GothamSemibold
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.LayoutOrder = 5 
    local cornerBtn = Instance.new("UICorner") cornerBtn.CornerRadius = UDim.new(0, 6) cornerBtn.Parent = btn
    btn.Parent = Frame

    btn.MouseButton1Click:Connect(function()
        -- Restaurar Hitbox del objetivo anterior si cambiamos de persona
        if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local oldRoot = TargetPlayer.Character.HumanoidRootPart
            oldRoot.Size = Vector3.new(2, 2, 1)
            oldRoot.Transparency = 1
        end

        if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("KillHighlight") then
            TargetPlayer.Character.KillHighlight:Destroy()
        end

        if TargetPlayer == player then
            TargetPlayer = nil
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        else
            for _, child in ipairs(Frame:GetChildren()) do
                if child:IsA("TextButton") and child.LayoutOrder == 5 then
                    child.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                end
            end
            
            TargetPlayer = player
            btn.BackgroundColor3 = Color3.fromRGB(40, 200, 70) 
        end
    end)
end

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        createPlayerButton(plr)
    end
end

Players.PlayerAdded:Connect(createPlayerButton)
Players.PlayerRemoving:Connect(function(plr)
    if TargetPlayer == plr then TargetPlayer = nil end
    local button = Frame:FindFirstChild(plr.Name)
    if button then button:Destroy() end
end)

-- ==========================================
-- 4. RESTAURAR PERSONAJE
-- ==========================================
local function restoreCharacter()
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name ~= "HumanoidRootPart" then part.Transparency = 0 end
                part.CanCollide = true
                part.Massless = false
            elseif part:IsA("Decal") and part.Name == "face" then
                part.Transparency = 0
            end
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = false end
    end
end

-- ==========================================
-- 5. AIMBOT PURO (CÁMARA)
-- ==========================================
RunService:BindToRenderStep("LethalAimbot", 201, function()
    if AimbotEnabled and TargetPlayer and TargetPlayer.Character then
        local targetHead = TargetPlayer.Character:FindFirstChild("Head")
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)

-- ==========================================
-- 6. MOTOR DE FÍSICAS (TELEPORT Y HITBOX)
-- ==========================================
RunService.Heartbeat:Connect(function()
    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    
    if localRoot then
        local targetCharacter = TargetPlayer and TargetPlayer.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        local targetHead = targetCharacter and targetCharacter:FindFirstChild("Head")
        
        -- SISTEMA DE HITBOX EXPANDER
        if targetRoot then
            if HitboxEnabled then
                targetRoot.Size = Vector3.new(20, 20, 20)
                targetRoot.Transparency = 0.6
                targetRoot.BrickColor = BrickColor.new("Bright purple")
                targetRoot.CanCollide = false
            else
                -- Regresarlo a la normalidad si apagas el botón
                targetRoot.Size = Vector3.new(2, 2, 1)
                targetRoot.Transparency = 1
            end
        end

        -- SISTEMA DE TELEPORT / GHOST
        if TeleportEnabled and targetRoot then
            WasHovering = true
            localRoot.Anchored = true
            
            for _, part in ipairs(localCharacter:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("Decal") then
                    part.Transparency = 1
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.Massless = true
                    end
                end
            end
            
            if not targetCharacter:FindFirstChild("KillHighlight") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "KillHighlight"
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0.1
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = targetCharacter
            end
            
            local hoverPosition = (targetRoot.CFrame * CFrame.new(0, 8, 3)).Position
            
            if AimbotEnabled and targetHead then
                localRoot.CFrame = CFrame.lookAt(hoverPosition, targetHead.Position)
            else
                localRoot.CFrame = CFrame.new(hoverPosition)
            end
            
        else
            if WasHovering then
                restoreCharacter()
                WasHovering = false
                
                if targetCharacter and targetCharacter:FindFirstChild("KillHighlight") then
                    targetCharacter.KillHighlight:Destroy()
                end
            end
        end
    end
end)
