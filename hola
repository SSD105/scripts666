btnAimbot.Text = "AIMBOT: OFF"
btnAimbot.Font = Enum.Font.GothamBlack
btnAimbot.TextColor3 = Color3.fromRGB(255, 255, 255)
btnAimbot.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
