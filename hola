local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Camera = workspace.CurrentCamera

local Selected = {}

-- ==========================================
-- 1. INTERFAZ GRÁFICA (UI)
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PlayerSelectorGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Frame = Instance.new("ScrollingFrame")
Frame.Size = UDim2.new(0, 200, 0, 300)
Frame.Position = UDim2.new(0, 50, 0, 100)
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Frame.BorderSizePixel = 0
Frame.ScrollBarImageColor3 = Color3.fromRGB(150, 150, 150)
Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y 
Frame.CanvasSize = UDim2.new(0, 0, 0, 0)
Frame.Parent = ScreenGui
Frame.Active = true
Frame.Draggable = true 

local UICornerFrame = Instance.new("UICorner")
UICornerFrame.CornerRadius = UDim.new(0, 8)
UICornerFrame.Parent = Frame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Padding = UDim.new(0, 5)
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIListLayout.SortOrder = Enum.SortOrder.Name
UIListLayout.Parent = Frame

local UIPadding = Instance.new("UIPadding")
UIPadding.PaddingTop = UDim.new(0, 5)
UIPadding.PaddingBottom = UDim.new(0, 5)
UIPadding.Parent = Frame

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightControl then
        Frame.Visible = not Frame.Visible
    end
end)

local function createPlayerButton(player)
    if Frame:FindFirstChild(player.Name) then return end 

    local btn = Instance.new("TextButton")
    btn.Name = player.Name
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Text = player.Name
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.AutoButtonColor = true
    
    local UICornerBtn = Instance.new("UICorner")
    UICornerBtn.CornerRadius = UDim.new(0, 6)
    UICornerBtn.Parent = btn
    
    btn.Parent = Frame

    btn.MouseButton1Click:Connect(function()
        if Selected[player.Name] then
            Selected[player.Name] = nil
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            
            if player.Character and player.Character:FindFirstChild("KillHighlight") then
                player.Character.KillHighlight:Destroy()
            end
        else
            for k, v in pairs(Selected) do
                Selected[k] = nil
                local oldBtn = Frame:FindFirstChild(k)
                if oldBtn then oldBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45) end
            end
            
            Selected[player.Name] = player
            btn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
        end
    end)
end

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        createPlayerButton(plr)
    end
end

Players.PlayerAdded:Connect(createPlayerButton)

Players.PlayerRemoving:Connect(function(plr)
    Selected[plr.Name] = nil 
    local button = Frame:FindFirstChild(plr.Name)
    if button then button:Destroy() end
end)

-- ==========================================
-- 2. AIMBOT (BLOQUEO DE CÁMARA AGRESIVO)
-- ==========================================
RunService:BindToRenderStep("LethalAimbot", 201, function()
    local targetHead = nil
    for _, targetPlayer in pairs(Selected) do
        local targetCharacter = targetPlayer.Character
        if targetCharacter then
            targetHead = targetCharacter:FindFirstChild("Head")
            if targetHead then break end
        end
    end

    if targetHead then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
    end
end)

-- ==========================================
-- 3. MOTOR FÍSICO Y ESP BLINDADO
-- ==========================================
RunService.Heartbeat:Connect(function()
    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    
    if localRoot then
        local isAttached = false
        
        for _, part in ipairs(localCharacter:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                part.Transparency = 1
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.Massless = true
                end
            end
        end
        
        for name, targetPlayer in pairs(Selected) do
            local targetCharacter = targetPlayer.Character
            local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
            local targetHead = targetCharacter and targetCharacter:FindFirstChild("Head")
            
            if targetRoot and targetHead then
                isAttached = true
                
                -- Extraemos la posición estable del RootPart (arriba y atrás)
                local offsetPosition = (targetRoot.CFrame * CFrame.new(0, 8, 3)).Position
                
                -- Combinamos nuestra posición estable con la rotación exacta de su cabeza
                localRoot.CFrame = CFrame.new(offsetPosition) * targetHead.CFrame.Rotation
                
                if not targetCharacter:FindFirstChild("KillHighlight") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "KillHighlight"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0.1
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = targetCharacter
                end
            end
        end
        
        localRoot.Anchored = isAttached
    end
end)
