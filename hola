Separator.Parent = Frame

-- ==========================================
-- 3. LISTA DE JUGADORES
-- ==========================================
local function createPlayerButton(player)
    if Frame:FindFirstChild(player.Name) then return end 

    local btn = Instance.new("TextButton")
    btn.Name = player.Name
    btn.Size = UDim2.new(1, -10, 0, 30)
    btn.Text = player.Name
    btn.Font = Enum.Font.GothamSemibold
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.LayoutOrder = 4 -- Debajo de los toggles
    local cornerBtn = Instance.new("UICorner") cornerBtn.CornerRadius = UDim.new(0, 6) cornerBtn.Parent = btn
    btn.Parent = Frame

    btn.MouseButton1Click:Connect(function()
        -- Limpiar highlight del objetivo anterior si existe
        if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("KillHighlight") then
            TargetPlayer.Character.KillHighlight:Destroy()
        end

        if TargetPlayer == player then
            TargetPlayer = nil
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        else
            -- Reiniciar colores de todos los botones de jugadores
            for _, child in ipairs(Frame:GetChildren()) do
                if child:IsA("TextButton") and child.LayoutOrder == 4 then
                    child.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                end
            end
            
            TargetPlayer = player
            btn.BackgroundColor3 = Color3.fromRGB(40, 200, 70) 
        end
    end)
end

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        createPlayerButton(plr)
    end
end

Players.PlayerAdded:Connect(createPlayerButton)
Players.PlayerRemoving:Connect(function(plr)
    if TargetPlayer == plr then TargetPlayer = nil end
    local button = Frame:FindFirstChild(plr.Name)
    if button then button:Destroy() end
end)

-- ==========================================
-- 4. RESTAURAR PERSONAJE (Apagar Ghost Mode)
-- ==========================================
local function restoreCharacter()
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name ~= "HumanoidRootPart" then part.Transparency = 0 end
                part.CanCollide = true
                part.Massless = false
            elseif part:IsA("Decal") and part.Name == "face" then
                part.Transparency = 0
            end
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = false end
    end
end

-- ==========================================
-- 5. AIMBOT PURO (CÁMARA)
-- ==========================================
RunService:BindToRenderStep("LethalAimbot", 201, function()
    if AimbotEnabled and TargetPlayer and TargetPlayer.Character then
        local targetHead = TargetPlayer.Character:FindFirstChild("Head")
        if targetHead then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
        end
    end
end)

-- ==========================================
-- 6. MOTOR DE TELETRANSPORTE Y FÍSICAS
-- ==========================================
RunService.Heartbeat:Connect(function()
    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    
    if localRoot then
        local targetCharacter = TargetPlayer and TargetPlayer.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        local targetHead = targetCharacter and targetCharacter:FindFirstChild("Head")
        
        -- Si TELEPORT está encendido y hay objetivo
        if TeleportEnabled and targetRoot then
            WasHovering = true
            localRoot.Anchored = true
            
            -- Volverse fantasma
            for _, part in ipairs(localCharacter:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("Decal") then
                    part.Transparency = 1
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.Massless = true
                    end
                end
            end
            
            -- Aplicar ESP al objetivo
            if not targetCharacter:FindFirstChild("KillHighlight") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "KillHighlight"
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0.1
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = targetCharacter
            end
            
            -- Calcular posición
            local hoverPosition = (targetRoot.CFrame * CFrame.new(0, 8, 3)).Position
            
            -- Si el Aimbot también está encendido, el cuerpo apunta a la cabeza
            if AimbotEnabled and targetHead then
                localRoot.CFrame = CFrame.lookAt(hoverPosition, targetHead.Position)
            else
                localRoot.CFrame = CFrame.new(hoverPosition)
            end
            
        else
            -- Si apagamos el TELEPORT, devolvemos el personaje a la normalidad
            if WasHovering then
                restoreCharacter()
                WasHovering = false
                
                -- Limpiar ESP si apagaste el teleport
                if targetCharacter and targetCharacter:FindFirstChild("KillHighlight") then
                    targetCharacter.KillHighlight:Destroy()
                end
            end
        end
    end
end)
