local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Camera = workspace.CurrentCamera

local Selected = {}
local OriginalSizes = {} -- Guardaremos el tamaño original de las cabezas para cuando los deselecciones

-- ==========================================
-- 1. INTERFAZ GRÁFICA (UI)
-- ==========================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PlayerSelectorGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Frame = Instance.new("ScrollingFrame")
Frame.Size = UDim2.new(0, 200, 0, 300)
Frame.Position = UDim2.new(0, 50, 0, 100)
Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Frame.BorderSizePixel = 0
Frame.ScrollBarImageColor3 = Color3.fromRGB(200, 200, 200)
Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y 
Frame.CanvasSize = UDim2.new(0, 0, 0, 0)
Frame.Parent = ScreenGui

local UICornerFrame = Instance.new("UICorner")
UICornerFrame.CornerRadius = UDim.new(0, 8)
UICornerFrame.Parent = Frame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Padding = UDim.new(0, 5)
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIListLayout.SortOrder = Enum.SortOrder.Name
UIListLayout.Parent = Frame

local UIPadding = Instance.new("UIPadding")
UIPadding.PaddingTop = UDim.new(0, 5)
UIPadding.PaddingBottom = UDim.new(0, 5)
UIPadding.Parent = Frame

local function createPlayerButton(player)
    if Frame:FindFirstChild(player.Name) then return end 

    local btn = Instance.new("TextButton")
    btn.Name = player.Name
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Text = player.Name
    btn.Font = Enum.Font.GothamSemibold
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.AutoButtonColor = true
    
    local UICornerBtn = Instance.new("UICorner")
    UICornerBtn.CornerRadius = UDim.new(0, 6)
    UICornerBtn.Parent = btn
    
    btn.Parent = Frame

    btn.MouseButton1Click:Connect(function()
        if Selected[player.Name] then
            -- DESELECCIONAR: Revertir todo a la normalidad
            Selected[player.Name] = nil
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            
            local char = player.Character
            if char then
                if char:FindFirstChild("KillHighlight") then
                    char.KillHighlight:Destroy()
                end
                
                -- Restaurar tamaño de la cabeza
                local head = char:FindFirstChild("Head")
                if head and OriginalSizes[player.Name] then
                    head.Size = OriginalSizes[player.Name]
                    head.Transparency = 0 -- Ocultar la magia de nuevo
                    head.CanCollide = true
                end
            end
        else
            -- SELECCIONAR: Activar modo letal
            Selected[player.Name] = player
            btn.BackgroundColor3 = Color3.fromRGB(180, 20, 20) 
            
            -- Guardar el tamaño original de su cabeza por si lo deseleccionas
            local char = player.Character
            if char and char:FindFirstChild("Head") then
                OriginalSizes[player.Name] = char.Head.Size
            end
        end
    end)
end

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        createPlayerButton(plr)
    end
end

Players.PlayerAdded:Connect(createPlayerButton)

Players.PlayerRemoving:Connect(function(plr)
    Selected[plr.Name] = nil 
    OriginalSizes[plr.Name] = nil
    local button = Frame:FindFirstChild(plr.Name)
    if button then button:Destroy() end
end)

-- ==========================================
-- 2. MOTOR DE COMBATE, ESP Y HITBOXES
-- ==========================================
RunService.Heartbeat:Connect(function()
    local localCharacter = LocalPlayer.Character
    local localTorso = localCharacter and (localCharacter:FindFirstChild("Torso") or localCharacter:FindFirstChild("UpperTorso"))
    local localHead = localCharacter and localCharacter:FindFirstChild("Head")
    
    if localTorso then
        -- MODO FANTASMA (Tú eres invisible e intocable)
        for _, part in ipairs(localCharacter:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                part.Transparency = 1
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.Massless = true
                end
            end
        end
        
        -- ATAQUE AL OBJETIVO
        for name, targetPlayer in pairs(Selected) do
            local targetCharacter = targetPlayer.Character
            local targetTorso = targetCharacter and (targetCharacter:FindFirstChild("Torso") or targetCharacter:FindFirstChild("UpperTorso"))
            local targetHead = targetCharacter and targetCharacter:FindFirstChild("Head")
            
            if targetTorso and targetHead then
                -- 1. Wallhack (ESP) a través de las paredes
                if not targetCharacter:FindFirstChild("KillHighlight") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "KillHighlight"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0.1
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = targetCharacter
                end
                
                -- 2. Expansor de Hitbox (Cabeza GIGANTE)
                -- Multiplicamos su tamaño, ahora es un bloque de 8x8x8 studs
                targetHead.Size = Vector3.new(8, 8, 8)
                targetHead.Transparency = 0.6 -- Un poco transparente para que veas el área de impacto
                targetHead.CanCollide = false -- Para que no se atore con las paredes
                
                -- 3. Seguimiento de cámara
                -- Ya no te teletransportas encima, ahora te quedas libre para disparar, 
                -- pero tu cámara apunta al centro de esa enorme cabeza.
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            end
        end
    end
end)
